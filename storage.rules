rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /notices/{fileName=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /resources/{fileName=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /press_releases/{fileName=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
